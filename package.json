{
  "name": "gourmet-card",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "playwright test",
    "typecheck": "tsc -b --noEmit",
    "lint": "oxlint",
    "fixtures": "node scripts/make-fixtures.mjs",
    "geo-data": "node scripts/build-geo-data.mjs",
    "e2e:dist": "playwright test -c playwright.dist.config.ts",
    "deploy": "npm run build && node scripts/deploy.mjs"
  },
  "dependencies": {
    "dexie": "^4.4.6",
    "jszip": "^3.10.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "gh-pages": "^6.3.0",
    "oxlint": "^1.81.0",
    "read-excel-file": "^9.3.10",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1"
  }
}
